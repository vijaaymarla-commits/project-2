# Supabase Configuration
# Replace with your Supabase Project URL and Anon/Service Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Settings
FLASK_ENV=development
SECRET_KEY=fresh-cuts-meat-shop-super-secret-key-2026
JWT_SECRET=fresh-cuts-jwt-secret-key-meat-shop-2026
PORT=5000

# Data Mode: 'supabase' (uses live Supabase) or 'auto' (falls back to local SQLite if Supabase credentials are placeholders)
DATA_MODE=auto
